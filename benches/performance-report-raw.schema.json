{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msgspec-toon.invalid/schemas/performance-report-raw-v1.json",
  "title": "msgspec-toon absolute-report raw performance evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "created_at",
    "source_revision",
    "dependency_lock_sha256",
    "manifest_sha256",
    "analysis_contract",
    "seed",
    "qualification_override",
    "design",
    "endpoints",
    "comparisons",
    "rows",
    "calibration",
    "workers",
    "warmups",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "absolute_report_raw"},
    "analysis_contract": {"const": "Python collects raw timings; R owns inference"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_revision": {"type": "string", "minLength": 1},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "integer"},
    "qualification_override": {"type": "boolean"},
    "design": {"type": "object"},
    "endpoints": {"type": "array", "minItems": 1},
    "comparisons": {"type": "array", "minItems": 1},
    "rows": {"type": "object"},
    "calibration": {"type": "object"},
    "workers": {"type": "array", "minItems": 2},
    "warmups": {"type": "array", "minItems": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "worker",
          "order_index",
          "sample",
          "loops",
          "elapsed_ns"
        ],
        "properties": {
          "cell_id": {"type": "string", "minLength": 1},
          "worker": {"type": "integer", "minimum": 0},
          "order_index": {"type": "integer", "minimum": 0},
          "sample": {"type": "integer", "minimum": 0},
          "loops": {"type": "integer", "minimum": 1},
          "elapsed_ns": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
